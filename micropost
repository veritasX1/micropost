#!/bin/bash
# See: micropost help
set -e

# Resolve post.py next to this script, regardless of where it's installed.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
POST_PY="$SCRIPT_DIR/post.py"

show_help() {
  cat <<'EOF'
micropost - a small command for your self-hosted microblog

  micropost your text without quotes
      Posts the text. No quotes needed.
      Example: micropost hello world

  micropost /path/to/image.jpg optional text
      One or more image paths anywhere in the text are automatically
      detected and attached (e.g. when you drag files into the
      terminal). Two or more images become a click-through gallery.
      The rest stays regular text.
      Example: micropost ~/Pictures/a.jpg ~/Pictures/b.jpg what a day
      Allowed formats: png, jpg, jpeg, gif, webp (max 15 MB each)

  micropost /path/to/clip.mp4 optional text
      A video path is likewise auto-detected. Only one video per
      post; it is not re-encoded, so compress it yourself first if
      size/load time matters.
      Allowed formats: mp4, webm, mov, m4v

  micropost img /path/to/image.jpg [/path/to/more.jpg ...] [text]
      Same as auto-detection, explicitly - in case it doesn't
      trigger (e.g. unusual filenames).

  micropost video /path/to/clip.mp4 [optional text]
      Same for video, explicitly.

  micropost show
      Lists the 10 most recent entries (ID, date, text).

  micropost del N
      Deletes post number N.
      Example: micropost del 13
      Important: type the ID WITHOUT # (in bash, # starts a
      comment and would cut off everything after it).

  micropost edit N new text
      Replaces the text of post number N.
      Example: micropost edit 24 new text here
      Same here: ID without #.

  micropost help
      Shows this help.

One-time setup (see README.md):
  MICROBLOG_URL and MICROBLOG_TOKEN need to be set, e.g. in ~/.bashrc.
EOF
}

# Checks whether $1 is an existing file with an image extension.
is_image_path() {
  case "$1" in
    *.png|*.PNG|*.jpg|*.JPG|*.jpeg|*.JPEG|*.gif|*.GIF|*.webp|*.WEBP)
      [ -f "$1" ]
      ;;
    *)
      return 1
      ;;
  esac
}

# Checks whether $1 is an existing file with a video extension.
is_video_path() {
  case "$1" in
    *.mp4|*.MP4|*.webm|*.WEBM|*.mov|*.MOV|*.m4v|*.M4V)
      [ -f "$1" ]
      ;;
    *)
      return 1
      ;;
  esac
}

if [ "$#" -eq 0 ]; then
  show_help >&2
  exit 1
fi

cmd="$1"
case "$cmd" in
  help|-h|--help)
    show_help
    exit 0
    ;;
  show)
    exec "$POST_PY" --show
    ;;
  del|delete)
    id="${2#\#}"
    if [ -z "$id" ]; then
      echo "Usage: micropost del N   (ID without #)" >&2
      exit 1
    fi
    exec "$POST_PY" --delete "$id"
    ;;
  edit)
    id="${2#\#}"
    shift 2 2>/dev/null || true
    if [ -z "$id" ] || [ "$#" -eq 0 ]; then
      echo "Usage: micropost edit N new text   (ID without #)" >&2
      exit 1
    fi
    exec "$POST_PY" --edit "$id" "$*"
    ;;
  img|image)
    shift
    paths=()
    while [ "$#" -gt 0 ] && is_image_path "$1"; do
      paths+=("$1")
      shift
    done
    if [ "${#paths[@]}" -eq 0 ]; then
      echo "Usage: micropost img /path/to/image.jpg [/path/to/more.jpg ...] [text]" >&2
      exit 1
    fi
    args=()
    for p in "${paths[@]}"; do
      args+=(--image "$p")
    done
    exec "$POST_PY" "$*" "${args[@]}"
    ;;
  video)
    path="$2"
    if [ -z "$path" ]; then
      echo "Usage: micropost video /path/to/clip.mp4 [optional text]" >&2
      exit 1
    fi
    shift 2 2>/dev/null || true
    exec "$POST_PY" "$*" --video "$path"
    ;;
  *)
    # Regular text post - but if image/video paths are mixed in anywhere
    # (e.g. dragged into the terminal), detect them automatically and
    # strip them out of the text. Multiple images become a gallery;
    # only the first video found is used.
    img_paths=()
    video_path=""
    words=()
    for w in "$@"; do
      if is_image_path "$w"; then
        img_paths+=("$w")
      elif [ -z "$video_path" ] && is_video_path "$w"; then
        video_path="$w"
      else
        words+=("$w")
      fi
    done
    args=()
    for p in "${img_paths[@]}"; do
      args+=(--image "$p")
    done
    if [ -n "$video_path" ]; then
      args+=(--video "$video_path")
    fi
    exec "$POST_PY" "${words[*]}" "${args[@]}"
    ;;
esac
